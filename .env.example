BOT_TOKEN=1234567890:replace_with_your_bot_token
ADMIN_CHAT_ID=-1001234567890
PUBLISH_CHAT_ID=-1009876543210
ADMIN_USER_IDS=111111111,222222222
SUBMISSION_COOLDOWN_SECONDS=120

# Anti-spam for user submissions: a plain-TEXT message shorter than either limit
# (in words OR characters) is bounced back with a hint instead of being queued.
# Links and media (photo/video/document) submissions are exempt — their URL/file
# is the content. Admins bypass the check. Set either to 0 to disable that half.
MIN_SUBMISSION_TEXT_WORDS=3
MIN_SUBMISSION_TEXT_CHARS=10
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OFFICIAL_NEWS_URL=https://www.marvelrivals.com/news/
NEWS_CHECK_INTERVAL_MINUTES=30
ARTICLE_TIMEZONE=Europe/Kyiv

# Optional. Defaults to bot.db when omitted.
# DATABASE_PATH=bot.db

# --- Optional Discord moderation module ---------------------------------------
# Independent from the Telegram flow. Used only to moderate our own Marvel
# Rivals UA Discord server. The bot must be invited with both the `bot` and
# `applications.commands` OAuth2 scopes, and the privileged "Message Content
# Intent" must be enabled in the Developer Portal. Required Discord permissions:
# View Channels, Send Messages, Manage Messages, Read Message History,
# Moderate Members, Embed Links, Use Application Commands (no Administrator).

# Set to true to start the Discord moderation bot. Anything else keeps it off.
ENABLE_DISCORD_MODERATION=false
# Bot token from the Discord Developer Portal. Keep it secret. Never commit it.
DISCORD_BOT_TOKEN=
# Channel ID where moderation actions are logged (enable Developer Mode in
# Discord, right-click the channel -> Copy Channel ID).
DISCORD_MOD_LOG_CHANNEL_ID=
# Optional, comma-separated invite codes (or full invite URLs) that are allowed.
# Leave empty to block ALL Discord invite links.
DISCORD_ALLOWED_INVITES=
# Optional guild ID. When set, slash commands sync instantly to that server;
# otherwise a global sync is used (can take up to ~1 hour to appear).
DISCORD_GUILD_ID=
# Optional welcome system. When DISCORD_WELCOME_CHANNEL_ID is set, the bot greets
# new members in that channel. This REQUIRES the privileged "Server Members
# Intent" enabled in the Developer Portal. Leave empty to disable public welcomes
# (the bot then does not request the members intent at all).
DISCORD_WELCOME_CHANNEL_ID=
# Optional channel IDs shown as links in the welcome message. Each is included
# only when set; channels are never hardcoded. Rules are NOT a channel — they are
# shown inline from discord_rules.txt (edit that file to change them).
DISCORD_CHAT_CHANNEL_ID=
DISCORD_LFT_CHANNEL_ID=

# --- Optional Telegram group-chat moderation ----------------------------------
# Moderates ONLY the chats whose IDs are listed below. Runs in the SAME process as
# the news/submission bot. Each moderated chat must be a SUPERGROUP, and the bot
# must be an ADMIN there with rights to Delete Messages and Ban/Restrict Users
# (an admin bot also receives all messages regardless of group privacy mode). All
# user-facing moderation text is Ukrainian. Every value below is parsed leniently:
# a typo is ignored, never crashing the bot.

# Set to true to enable Telegram chat moderation. Anything else keeps it off.
ENABLE_TELEGRAM_MODERATION=false
# Comma-separated chat IDs to moderate (supergroup IDs look like -1001234567890).
# A bad/typo entry is ignored. These MUST NOT include ADMIN_CHAT_ID or PUBLISH_CHAT_ID.
TELEGRAM_MODERATION_CHAT_IDS=
# Where moderation actions are logged. Defaults to ADMIN_CHAT_ID when left empty.
TELEGRAM_MOD_LOG_CHAT_ID=
# Comma-separated allowed t.me link codes/usernames (bare code or full URL).
# Empty = block ALL t.me invite/links from non-moderators.
TELEGRAM_LINK_ALLOWLIST=
# Seconds before the welcome message auto-deletes. 0 disables auto-delete.
TELEGRAM_WELCOME_DELETE_SECONDS=60

# --- Nightly database backup ---------------------------------------------------
# Once a day the bot snapshots its SQLite database (VACUUM INTO) into the
# backups/ folder next to the database file — on the persistent /data volume in
# production. Downloading the snapshots off the server is up to the operator.
# Enabled by default; set to false to turn off (a typo keeps the default).
ENABLE_DATABASE_BACKUP=true
# Local hour (0-23, in ARTICLE_TIMEZONE) when the snapshot is written.
DATABASE_BACKUP_HOUR=4
# How many newest snapshots to keep; older ones are pruned.
DATABASE_BACKUP_KEEP=14

# --- Cross-source duplicate filter ---------------------------------------------
# Before queuing a parsed article, the bot asks Gemini whether its title is the
# same specific story as a recently-seen one from any source — so the same news
# surfaced via several sources (site / YouTube / Bluesky / Reddit) is not posted
# twice. Needs GEMINI_API_KEY; fails open (keeps the item) on any error.
# Enabled by default; set to false to turn off (a typo keeps the default).
ENABLE_CROSS_SOURCE_DEDUP=true
# How many of the most recent titles to compare against (0 disables the check).
CROSS_SOURCE_DEDUP_TITLE_LIMIT=200

# --- Moderation-queue send pacing ----------------------------------------------
# When a scheduler tick finds several new items at once, they are sent to the
# moderation chat one every this-many seconds instead of all at once, so the bot
# does not spam a burst (and does not trip Telegram's per-chat flood limit). It is
# a MINIMUM gap: the first item in a tick is sent immediately. All items still get
# through — a tick's items just trickle in. 0 disables the pacing. Manual /collect
# is never delayed (it sends a single item).
MODERATION_SEND_INTERVAL_SECONDS=5

# --- Bluesky news source (opt-in) ----------------------------------------------
# When enabled, the bot polls the public Bluesky author feed below and queues new
# posts for moderation, like the official-site collector. Disabled by default.
ENABLE_BLUESKY_SOURCE=false
# Bluesky handle to follow (no leading @).
BLUESKY_ACTOR=marvelrivalsglobal.bsky.social
# Download a Bluesky post's video (its original MP4 blob, fetched via getBlob — no
# ffmpeg/HLS) and re-upload it as a NATIVE inline Telegram video. Videos over
# BLUESKY_VIDEO_MAX_MB (Telegram's bot upload cap) fall back to a text post.
ENABLE_BLUESKY_VIDEO_DOWNLOAD=true
BLUESKY_VIDEO_MAX_MB=48

# --- YouTube news source (opt-in) ----------------------------------------------
# When enabled, the bot polls the channel's public RSS feed and queues new videos
# for moderation. The channel re-uploads the same trailer under several video IDs,
# so videos are deduped by a NORMALISED TITLE, not the video id. Disabled by default.
ENABLE_YOUTUBE_SOURCE=false
# Channel ID to follow (default: official @MarvelRivals). NOT a fan channel.
YOUTUBE_CHANNEL_ID=UCWzmOSSiSPbVnVu3ZAyDx2w
# Comma-separated, case-insensitive title keywords that mark a video as noise to
# skip. Scoped to genuine esports-VOD coverage only (the channel ships reveal
# trailers as Shorts, so Shorts/"tournament" are intentionally NOT filtered).
# Leave unset to use the built-in default list; set to "-" to disable filtering.
# YOUTUBE_EXCLUDE_KEYWORDS=grand final,group stage,playoff,qualifier,highlights,esports
# Download the YouTube video (yt-dlp) and re-upload it as a NATIVE inline Telegram
# video instead of a tap-to-open link preview. Videos over YOUTUBE_VIDEO_MAX_MB
# (Telegram's bot upload limit) fall back to the link preview. false = always preview.
ENABLE_YOUTUBE_VIDEO_DOWNLOAD=true
YOUTUBE_VIDEO_MAX_MB=48

# --- Reddit leaks news source (opt-in) -----------------------------------------
# When enabled, the bot polls ONE combined flair-filtered search.rss feed of the
# subreddit below and queues new posts for moderation as RUMOURS (чутки). Reddit
# rate-limits hard, so it makes a single request per run. Disabled by default.
ENABLE_REDDIT_SOURCE=false
# Subreddit to poll (no "r/" prefix).
REDDIT_SUBREDDIT=MarvelRivalsLeaks
# Comma-separated flairs to include (combined with OR). Entries carry no flair
# text, so this query IS the filter.
# REDDIT_FLAIRS=Official News,Reliable,Confirmed
# Case-insensitive title keywords to skip (recurring sticky threads). Set to "-"
# to disable filtering.
# REDDIT_EXCLUDE_KEYWORDS=megathread

# --- rivalskins.com skin-leaks source (opt-in) ---------------------------------
# When enabled, the bot polls the rivalskins.com leaks RSS feed and queues new
# skin-leak posts (full-res renders, often a few days before a patch) for
# moderation as RUMOURS (чутки), like the Reddit source. Disabled by default.
ENABLE_RIVALSKINS_SOURCE=false
# The leaks RSS feed URL (no special User-Agent needed).
RIVALSKINS_FEED_URL=https://rivalskins.com/category/leaks/feed/

# --- Weekly "Чи знали ви?" wiki-facts rubric (opt-in) --------------------------
# Once a week the bot pulls one unseen hero "Trivia" fact from the Marvel Rivals
# Fandom wiki (CC BY-SA), translates it to Ukrainian via Gemini and queues a
# "Чи знали ви?" post for moderation, credited to the wiki. Needs GEMINI_API_KEY.
# Runs on its own weekday/hour (ARTICLE_TIMEZONE). Disabled by default.
ENABLE_WIKI_FACTS=false
# Weekday: 0=Mon .. 6=Sun, and local hour 0-23.
WIKI_FACTS_WEEKDAY=0
WIKI_FACTS_HOUR=12
# The wiki's api.php endpoint (default: official Marvel Rivals Fandom wiki).
WIKI_FACTS_API_URL=https://marvelrivals.fandom.com/api.php

# --- Weekly fan-art digest (opt-in) --------------------------------------------
# Once a week the bot queues ONE album post — the top "Fan Art" posts of the past
# week from FANART_SUBREDDIT, with author credits — into the moderation queue.
# Runs on its own weekday/hour, independent of the per-tick collectors.
ENABLE_FANART_DIGEST=false
# Subreddit and flair to pull the weekly top art from (no "r/" prefix).
FANART_SUBREDDIT=MarvelRivals
FANART_FLAIR=Fan Art
# When to build the digest, local time (ARTICLE_TIMEZONE). Weekday: 0=Mon .. 6=Sun.
FANART_DIGEST_WEEKDAY=4
FANART_DIGEST_HOUR=18
# How many top arts to include (Telegram album max is 10).
FANART_DIGEST_COUNT=10
